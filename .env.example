# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Email Service Configuration (for contact form)
# Using EmailJS (https://www.emailjs.com/)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Alternative: Using Resend (https://resend.com/)
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_TO_EMAIL=your@email.com

# Google Analytics 4 (GA4)
# Get your Measurement ID from https://analytics.google.com/
# 1. Create a GA4 property
# 2. Go to Admin > Data Streams > Web
# 3. Copy the Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity
# Get your Project ID from https://clarity.microsoft.com/
# 1. Create a free Clarity account
# 2. Add a new project with your website URL
# 3. Copy the Project ID (format: alphanumeric string like 'abc123xyz')
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Site Configuration
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Feature Flags (Optional)
# NEXT_PUBLIC_ENABLE_BLOG=false
# NEXT_PUBLIC_ENABLE_NEWSLETTER=false
