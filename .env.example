# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Email Service Configuration (for contact form)
# Using Resend (https://resend.com/)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=your@email.com

# Supabase Configuration (for database and authentication)
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Analytics 4 (GA4)
# Get your Measurement ID from https://analytics.google.com/
# 1. Create a GA4 property
# 2. Go to Admin > Data Streams > Web
# 3. Copy the Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity
# Get your Project ID from https://clarity.microsoft.com/
# 1. Create a free Clarity account
# 2. Add a new project with your website URL
# 3. Copy the Project ID (format: alphanumeric string like 'abc123xyz')
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Site Configuration
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Cloudinary Image CDN (fetch mode)
# 1. Create free account at https://cloudinary.com/users/register/free
# 2. Copy cloud name from dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD=your_cloud_name
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Feature Flags (Optional)
# NEXT_PUBLIC_ENABLE_BLOG=false
# NEXT_PUBLIC_ENABLE_NEWSLETTER=false
